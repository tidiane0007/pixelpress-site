# Clé créée dans Resend et à enregistrer dans Vercel, jamais dans Git.
RESEND_API_KEY=re_xxxxxxxxx
# Adresse expéditrice issue d'un domaine vérifié dans Resend.
CONTACT_FROM_EMAIL=PIXEL PRESS <contact@votre-domaine.sn>
# URL publique finale du site. Laisser vide sur Vercel ou Netlify : le site
# utilise l'adresse donnée par l'hébergeur (VERCEL_PROJECT_PRODUCTION_URL ou
# URL). Sur Vercel il faut aussi activer « Enable access to System Environment
# Variables » dans Settings → Environment Variables. Ne saisir une valeur ici
# que pour un nom de domaine à vous.
NEXT_PUBLIC_SITE_URL=
